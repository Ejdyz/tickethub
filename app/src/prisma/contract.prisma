// use prisma-8

model User {
  user_id           Int             @id @default(autoincrement())
  name              String
  email             String          @unique
  role              String
  created_at        DateTime?       @default(now())
  hourly_rate       Decimal?        @default(750.00)
  github_username   String?
  avatar_url        String?
  password_hash     String?
  is_admin          Boolean?        @default(false)

  supervised_projects Project[]     @relation("SupervisorProjects")
  member_projects     ProjectMember[]
  authored_tickets    Ticket[]      @relation("AuthorTickets")
  assigned_tickets    Ticket[]      @relation("AssigneeTickets")
  comments            Comment[]
  work_reports        WorkReport[]
  audit_logs          AuditLog[]
  budget_logs         ProjectBudgetLog[]

  @@map("users")
}

model Project {
  project_id             Int             @id @default(autoincrement())
  name                   String
  description            String?
  supervisor_id          Int
  budget                 Decimal?        @default(0.00)
  active                 Boolean?        @default(true)
  project_key            String?         @unique
  slug                   String?         @unique
  github_repo_url        String?
  github_repo_owner      String?
  github_repo_name       String?
  github_default_branch  String?         @default("main")
  github_sync_enabled    Boolean?        @default(false)
  status                 String?         @default("Active")
  currency               String?         @default("CZK")
  default_hourly_rate    Decimal?        @default(750.00)
  budget_alert_threshold Decimal?        @default(80.00)
  start_date             DateTime?
  target_end_date        DateTime?
  completed_at           DateTime?
  created_at             DateTime?       @default(now())
  updated_at             DateTime?       @default(now())

  supervisor             User            @relation("SupervisorProjects", fields: [supervisor_id], references: [user_id])
  members                ProjectMember[]
  milestones             ProjectMilestone[]
  tickets                Ticket[]
  budget_logs            ProjectBudgetLog[] @relation("ProjectBudgetLogs")
  related_budget_logs    ProjectBudgetLog[] @relation("RelatedProjectBudgetLogs")
  github_commits         ProjectGithubCommit[]

  @@map("project")
}

model ProjectMember {
  project_id         Int
  user_id            Int
  project_role       String?         @default("Developer")
  custom_hourly_rate Decimal?
  joined_at          DateTime?       @default(now())

  project            Project         @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  user               User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@map("project_member")
}

model ProjectMilestone {
  milestone_id     Int       @id @default(autoincrement())
  project_id       Int
  title            String
  description      String?
  due_date         DateTime?
  state            String?   @default("Open")
  budget_allocated Decimal?  @default(0.00)
  created_at       DateTime? @default(now())
  updated_at       DateTime? @default(now())

  project          Project   @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  tickets          Ticket[]

  @@map("project_milestone")
}

model Ticket {
  ticket_id           Int             @id @default(autoincrement())
  project_id          Int
  author_id           Int
  assignee_id         Int?
  parent_ticket_id    Int?
  name                String
  description         String
  priority            String?         @default("Medium")
  state               String?         @default("New")
  ticket_number       Int?
  ticket_type         String?         @default("Issue")
  estimated_hours     Decimal?        @default(0.00)
  due_date            DateTime?
  milestone_id        Int?
  github_issue_number Int?
  github_issue_url    String?
  created_at          DateTime?       @default(now())
  updated_at          DateTime?       @default(now())

  project             Project         @relation(fields: [project_id], references: [project_id])
  author              User            @relation("AuthorTickets", fields: [author_id], references: [user_id])
  assignee            User?           @relation("AssigneeTickets", fields: [assignee_id], references: [user_id])
  parent_ticket       Ticket?         @relation("SubTickets", fields: [parent_ticket_id], references: [ticket_id], onDelete: Cascade)
  sub_tickets         Ticket[]        @relation("SubTickets")
  milestone           ProjectMilestone? @relation(fields: [milestone_id], references: [milestone_id], onDelete: SetNull)
  comments            Comment[]
  work_reports        WorkReport[]
  audit_logs          AuditLog[]
  tags                TagTicket[]
  github_commits      ProjectGithubCommit[]

  @@map("ticket")
}

model Comment {
  comment_id Int       @id @default(autoincrement())
  ticket_id  Int
  author_id  Int
  content    String
  created_at DateTime? @default(now())

  ticket     Ticket    @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)
  author     User      @relation(fields: [author_id], references: [user_id])

  @@map("comment")
}

model AuditLog {
  audit_id       Int       @id @default(autoincrement())
  ticket_id      Int
  action         String
  before_state   String?
  new_state      String?
  change_user_id Int
  created_at     DateTime? @default(now())

  ticket         Ticket    @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)
  change_user    User      @relation(fields: [change_user_id], references: [user_id])

  @@map("audit_log")
}

model Tag {
  tag_id     Int         @id @default(autoincrement())
  name       String      @unique
  color_hex  String
  created_at DateTime?   @default(now())

  tickets    TagTicket[]

  @@map("tag")
}

model TagTicket {
  tag_id    Int
  ticket_id Int

  tag       Tag    @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade)
  ticket    Ticket @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade)

  @@id([tag_id, ticket_id])
  @@map("tag_ticket")
}

model WorkReport {
  report_id        Int       @id @default(autoincrement())
  ticket_id        Int
  user_id          Int
  work_date        DateTime? @default(now())
  work_hours       Decimal
  work_description String
  hourly_rate      Decimal?
  billable         Boolean?  @default(true)
  created_at       DateTime? @default(now())

  ticket           Ticket    @relation(fields: [ticket_id], references: [ticket_id])
  user             User      @relation(fields: [user_id], references: [user_id])

  @@map("work_report")
}

model ProjectBudgetLog {
  log_id                 Int       @id @default(autoincrement())
  project_id             Int
  change_type            String
  amount                 Decimal
  balance_before         Decimal
  balance_after          Decimal
  related_project_id     Int?
  changed_by_user_id     Int?
  note                   String?
  created_at             DateTime? @default(now())

  project                Project   @relation("ProjectBudgetLogs", fields: [project_id], references: [project_id], onDelete: Cascade)
  related_project        Project?  @relation("RelatedProjectBudgetLogs", fields: [related_project_id], references: [project_id])
  changed_by_user        User?     @relation(fields: [changed_by_user_id], references: [user_id])

  @@map("project_budget_log")
}

model ProjectGithubCommit {
  commit_id      Int       @id @default(autoincrement())
  project_id     Int
  ticket_id      Int?
  commit_hash    String
  commit_message String
  author_name    String?
  author_email   String?
  commit_url     String?
  committed_at   DateTime
  created_at     DateTime? @default(now())

  project        Project   @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  ticket         Ticket?   @relation(fields: [ticket_id], references: [ticket_id], onDelete: SetNull)

  @@unique([project_id, commit_hash])
  @@map("project_github_commit")
}

